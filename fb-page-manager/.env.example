# Cổng chạy web và URL công khai (dùng làm OAuth redirect: <BASE_URL>/auth/callback)
PORT=3000
BASE_URL=http://localhost:3000

# Facebook App (https://developers.facebook.com/apps) — loại "Business"
FB_APP_ID=
FB_APP_SECRET=
FB_GRAPH_VERSION=v24.0
# Chỉ cần nếu App dùng "Facebook Login for Business": tạo Configuration (chọn các quyền Page) rồi dán ID vào đây
FB_LOGIN_CONFIG_ID=

# Claude API để phân tích & viết bài (https://console.anthropic.com)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# Giãn cách giữa mỗi Page khi đăng hàng loạt (ms) — tránh bị đánh dấu spam
PUBLISH_DELAY_MS=3000

# Đặt mật khẩu nếu deploy lên server công khai (đăng nhập: user bất kỳ / mật khẩu này)
APP_PASSWORD=
